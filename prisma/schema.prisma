generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  RIDER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                      String                  @id @default(uuid()) @db.Uuid
  fullName                String
  email                   String                  @unique
  passwordHash            String
  phoneNumber             String?
  role                    UserRole                @default(CUSTOMER)
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  orders                  Order[]
  riderDeliveries         Delivery[]              @relation("DeliveryRider")
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  changedDeliveryStatuses DeliveryStatusHistory[] @relation("StatusChangedBy")
  assignmentActions       DeliveryAssignment[]    @relation("AssignmentActor")
  riderAssignmentHistory  DeliveryAssignment[]    @relation("AssignmentRider")

  @@index([role, isActive])
}

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  orderNumber          String      @unique
  customerId           String      @db.Uuid
  pickupAddress        String
  pickupLatitude       Decimal?    @db.Decimal(9, 6)
  pickupLongitude      Decimal?    @db.Decimal(9, 6)
  deliveryAddress      String
  deliveryLatitude     Decimal?    @db.Decimal(9, 6)
  deliveryLongitude    Decimal?    @db.Decimal(9, 6)
  packageDescription   String
  deliveryInstructions String?
  deliveryFee          Decimal     @db.Decimal(12, 2)
  currency             String      @db.VarChar(3)
  status               OrderStatus @default(PENDING_PAYMENT)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  customer             User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  delivery             Delivery?
  payments             Payment[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model Delivery {
  id            String                  @id @default(uuid()) @db.Uuid
  orderId       String                  @unique @db.Uuid
  riderId       String?                 @db.Uuid
  status        DeliveryStatus          @default(PENDING_ASSIGNMENT)
  assignedAt    DateTime?
  acceptedAt    DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  failureReason String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  order         Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  rider         User?                   @relation("DeliveryRider", fields: [riderId], references: [id], onDelete: SetNull)
  locations     DeliveryLocation[]
  statusHistory DeliveryStatusHistory[]
  assignments   DeliveryAssignment[]

  @@index([riderId, status])
  @@index([status, createdAt])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @db.Uuid
  provider          String?
  providerReference String?       @unique
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.VarChar(3)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([status, createdAt])
}

model DeliveryLocation {
  id         String   @id @default(uuid()) @db.Uuid
  deliveryId String   @db.Uuid
  latitude   Decimal  @db.Decimal(9, 6)
  longitude  Decimal  @db.Decimal(9, 6)
  recordedAt DateTime @default(now())
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, recordedAt])
}

model Notification {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @db.Uuid
  type          String
  title         String
  message       String
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
}

model DeliveryStatusHistory {
  id             String          @id @default(uuid()) @db.Uuid
  deliveryId     String          @db.Uuid
  previousStatus DeliveryStatus?
  newStatus      DeliveryStatus
  changedById    String?         @db.Uuid
  createdAt      DateTime        @default(now())
  delivery       Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  changedBy      User?           @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([deliveryId, createdAt])
}

model DeliveryAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  deliveryId   String    @db.Uuid
  riderId      String    @db.Uuid
  assignedById String    @db.Uuid
  assignedAt   DateTime  @default(now())
  endedAt      DateTime?
  delivery     Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  rider        User      @relation("AssignmentRider", fields: [riderId], references: [id], onDelete: Restrict)
  assignedBy   User      @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([deliveryId, assignedAt])
  @@index([riderId, assignedAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}
